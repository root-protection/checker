<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>FF ARENA | Security Scan</title>

<style>
* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  min-height: 100vh;
  background: #080808;
  color: white;
  font-family: Arial, sans-serif;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 20px;
}

.container {
  width: 100%;
  max-width: 420px;
  background: #121212;
  border: 1px solid #292929;
  border-radius: 18px;
  padding: 28px 22px;
  text-align: center;
  box-shadow: 0 0 35px #ff4b0020;
}

.logo {
  color: #ff4b00;
  font-size: 34px;
  font-weight: 900;
  letter-spacing: 3px;
  margin-bottom: 8px;
}

.subtitle {
  color: #aaa;
  font-size: 13px;
  margin-bottom: 28px;
}

h2 {
  font-size: 21px;
  margin-bottom: 20px;
}

input {
  width: 100%;
  padding: 15px;
  margin: 8px 0;
  border: 1px solid #383838;
  border-radius: 9px;
  background: #080808;
  color: white;
  font-size: 15px;
  outline: none;
}

input:focus {
  border-color: #ff4b00;
}

button {
  width: 100%;
  border: none;
  border-radius: 9px;
  padding: 15px;
  margin-top: 15px;
  background: #ff4b00;
  color: white;
  font-size: 16px;
  font-weight: bold;
  cursor: pointer;
}

button:active {
  transform: scale(.98);
}

.notice {
  color: #888;
  font-size: 11px;
  line-height: 1.5;
  margin-top: 20px;
}

.hidden {
  display: none !important;
}

.scanner {
  width: 145px;
  height: 145px;
  margin: 28px auto;
  border: 3px solid #333;
  border-radius: 50%;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 46px;
  color: #ff4b00;
  box-shadow: 0 0 25px #ff4b0020;
}

.scanner::after {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 50%;
  border-top: 3px solid #ff4b00;
  border-radius: 100px 100px 0 0;
  animation: spin 1.2s linear infinite;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.progress-bg {
  width: 100%;
  height: 8px;
  border-radius: 10px;
  background: #333;
  overflow: hidden;
  margin: 20px 0 12px;
}

.progress {
  width: 0%;
  height: 100%;
  background: #ff4b00;
  transition: width .15s linear;
}

#percent {
  color: #ff4b00;
  font-size: 14px;
  font-weight: bold;
}

.result {
  border: 2px solid #ff2020;
  background: #210606;
  border-radius: 14px;
  padding: 24px 16px;
  animation: appear .5s ease;
}

@keyframes appear {
  from { opacity: 0; transform: scale(.9); }
  to { opacity: 1; transform: scale(1); }
}

.warning-icon {
  font-size: 65px;
  margin-bottom: 12px;
}

.result h1 {
  color: #ff3030;
  font-size: 29px;
  font-weight: 900;
  margin-bottom: 15px;
}

.result p {
  color: #ddd;
  line-height: 1.6;
  font-size: 14px;
}

.player-info {
  background: #111;
  padding: 12px;
  margin: 18px 0;
  border-radius: 8px;
  overflow-wrap: anywhere;
  font-size: 13px;
  line-height: 1.8;
}

.result button {
  background: #d71919;
}

#scanStatus {
  color: #ddd;
  font-size: 13px;
  min-height: 20px;
}
</style>
</head>

<body>
<div class="container">

  <div class="logo">FF ARENA</div>
  <div class="subtitle">PLAYER SECURITY CENTER</div>

  <section id="formScreen">
    <h2>Player Security Check</h2>

    <form id="scanForm">
      <input id="playerName"
             type="text"
             placeholder="Free Fire Player Name"
             maxlength="40"
             required>

      <input id="playerUID"
             type="text"
             placeholder="Free Fire UID"
             inputmode="numeric"
             maxlength="25"
             required>

      <input id="phoneModel"
             type="text"
             placeholder="Phone Model (Optional)"
             maxlength="60">

      <button type="submit">START SECURITY SCAN</button>
    </form>

    <p class="notice">
      This page runs a visual simulation only. It cannot access
      Free Fire accounts or verify whether a player uses hacks.
    </p>
  </section>

  <section id="scanScreen" class="hidden">
    <h2>ANALYZING PLAYER</h2>

    <div class="scanner">⌕</div>

    <p id="scanStatus">Initializing security scan...</p>

    <div class="progress-bg">
      <div class="progress" id="progress"></div>
    </div>

    <div id="percent">0%</div>

    <p class="notice">
      Please wait while the visual scan animation completes.
    </p>
  </section>

  <section id="resultScreen" class="hidden">
    <div class="result">
      <div class="warning-icon">⚠️</div>

      <h1>SUSPICIOUS<br>HACKER</h1>

      <p>PLAYER SECURITY ALERT</p>

      <div class="player-info">
        <div>Player: <strong id="resultName"></strong></div>
        <div>UID: <strong id="resultUID"></strong></div>
        <div>Device: <strong id="resultPhone"></strong></div>
      </div>

      <p>
        Suspicious activity alert generated by the
        simulation.
      </p>

      <p class="notice">
        SIMULATED RESULT — This is not a real hack detection
        or an official Garena security report.
      </p>

      <button onclick="resetScan()">SCAN AGAIN</button>
    </div>
  </section>

</div>

<script>
const form = document.getElementById("scanForm");
const formScreen = document.getElementById("formScreen");
const scanScreen = document.getElementById("scanScreen");
const resultScreen = document.getElementById("resultScreen");
const progress = document.getElementById("progress");
const percent = document.getElementById("percent");
const scanStatus = document.getElementById("scanStatus");

const messages = [
  "Initializing security scan...",
  "Analyzing player information...",
  "Checking simulated security indicators...",
  "Processing scan animation...",
  "Preparing security report..."
];

form.addEventListener("submit", function(event) {
  event.preventDefault();

  const name = document.getElementById("playerName").value.trim();
  const uid = document.getElementById("playerUID").value.trim();
  const phone = document.getElementById("phoneModel").value.trim();

  if (!name || !uid) {
    alert("Please enter your player name and UID.");
    return;
  }

  document.getElementById("resultName").textContent = name;
  document.getElementById("resultUID").textContent = uid;
  document.getElementById("resultPhone").textContent = phone || "Not provided";

  formScreen.classList.add("hidden");
  resultScreen.classList.add("hidden");
  scanScreen.classList.remove("hidden");

  let value = 0;

  progress.style.width = "0%";
  percent.textContent = "0%";
  scanStatus.textContent = messages[0];

  const timer = setInterval(function() {
    value += 1;

    progress.style.width = value + "%";
    percent.textContent = value + "%";

    if (value === 20) scanStatus.textContent = messages[1];
    if (value === 40) scanStatus.textContent = messages[2];
    if (value === 65) scanStatus.textContent = messages[3];
    if (value === 85) scanStatus.textContent = messages[4];

    if (value >= 100) {
      clearInterval(timer);

      setTimeout(function() {
        scanScreen.classList.add("hidden");
        resultScreen.classList.remove("hidden");
      }, 250);
    }
  }, 60);
});

function resetScan() {
  resultScreen.classList.add("hidden");
  scanScreen.classList.add("hidden");
  formScreen.classList.remove("hidden");
  form.reset();
}
</script>
</body>
</html>
